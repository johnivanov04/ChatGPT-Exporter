{
  "manifest_version": 3,
  "name": "ChatVault",
  "version": "0.6.0",
  "description": "Export your ChatGPT or Claude conversations to PDF, Markdown, or JSON — including attached files. Local-first, no servers.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export to ChatVault",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chatvault.space/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["lib/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "lib/html-to-markdown.js",
        "lib/fetch-attachment.js",
        "lib/attachment-detection.js",
        "lib/auto-click.js",
        "content-chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["lib/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "lib/html-to-markdown.js",
        "lib/fetch-attachment.js",
        "lib/attachment-detection.js",
        "lib/auto-click.js",
        "content-claude.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatvault.space/*"],
      "js": ["content-chatvault.js"],
      "run_at": "document_idle"
    }
  ]
}
